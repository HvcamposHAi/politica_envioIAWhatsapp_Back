# Backend da Central de Mensagens — campanha Indiara.
#
# Infraestrutura: Render (este serviço) + Supabase (banco, auth, storage) +
# Cloudflare (front). Ver docs/DEPLOY_CLOUDFLARE_RENDER_SUPABASE.md.
#
# Em produção estas variáveis vivem no painel do Render, não num arquivo.
# A `service_role` nunca sai daqui para o front, em nenhuma circunstância.
#
# ⚠️  O projeto Supabase é NOVO e dedicado a esta campanha. Não reaproveitar
#     credencial de nenhum outro projeto — este backend roda com
#     service_role, que ignora RLS e lê tudo.

# --------------------------------------------------------------------
# Supabase — projeto dedicado da campanha
# --------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# service_role: bypassa RLS. Nunca expor ao front. Nunca logar.
SUPABASE_SERVICE_ROLE_KEY=
#
# NÃO EXISTE DATABASE_URL. Este arquivo já afirmou que o worker Baileys
# precisava de conexão direta ao Postgres — era falso, e custava tempo de
# quem tentava configurar. Nenhum arquivo em src/ lê essa variável:
# channels/auth-state.postgres.ts grava as credenciais de sessão em
# hub.canal_sessoes pelo supabaseAdmin, ou seja, PostgREST sobre HTTPS.
#
# Consequência prática: não há IPv6 inalcançável nem escolha entre modos do
# pooler do Supabase. É o motivo de este backend rodar no Render sem nenhum
# ajuste de rede.

# --------------------------------------------------------------------
# IA
# --------------------------------------------------------------------
# Personalização do disparo, resposta 1:1, triagem e painel analítico.
ANTHROPIC_API_KEY=

# --------------------------------------------------------------------
# Disparo (Fase 3) — ritmo da linha
# --------------------------------------------------------------------
# Estes são os TETOS do processo, o piso de segurança que nenhum disparo
# configurado na UI pode ultrapassar. O que o admin configura por campanha
# fica em hub.disparos; o que está aqui é o limite duro do ambiente.
#
# Janela de envio (hora local de São Paulo). Fora dela o worker dorme.
# Sem envio de madrugada: é o comportamento que mais gera denúncia.
DISPARO_JANELA_INICIO=09:00
DISPARO_JANELA_FIM=20:00
# Intervalo entre mensagens, em segundos. O worker sorteia dentro da
# faixa a cada envio.
DISPARO_INTERVALO_MIN_SEG=25
DISPARO_INTERVALO_MAX_SEG=90
# Rampa de aquecimento por dia de vida do canal, em mensagens/dia.
# Linha nova não começa disparando (ver Fase 3 do plano).
DISPARO_RAMPA=40,80,150,250,400
# Limiares de pausa automática, em percentual da janela recente.
DISPARO_LIMIAR_FALHA_PCT=15
DISPARO_LIMIAR_OPTOUT_PCT=5
# Interruptor geral. `false` faz o worker recusar qualquer envio em massa
# sem precisar de redeploy — a válvula de escape se algo der errado.
DISPARO_ATIVO=true

# --------------------------------------------------------------------
# Twilio — opcional, só para conversa 1:1
# --------------------------------------------------------------------
# O disparo em massa desta plataforma é por Baileys (decisão de 31/08).
# O adapter Twilio continua no código e serve a canais com
# transporte='twilio' para atendimento 1:1. Deixar em branco desliga.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# URL pública e ESTÁVEL deste serviço (a mesma cadastrada no Console da
# Twilio como webhook), usada para reconstruir a URL assinada na validação
# de X-Twilio-Signature. NÃO derivar de req.protocol/host em runtime — o
# Render, como o Cloud Run antes dele, termina TLS antes do container.
TWILIO_WEBHOOK_BASE_URL=
#
# NÃO DEFINA GCP_PROJECT_ID nesta infraestrutura. A presença dela liga o
# caminho do Secret Manager em services/twilioCredenciais.ts e desliga a
# leitura por variável de ambiente — as duas acima parariam de ser lidas.
# Ausente é o modo certo aqui.
GCP_PROJECT_ID=

# --------------------------------------------------------------------
# Mídia do WhatsApp
# --------------------------------------------------------------------
# Bucket PRIVADO do Supabase Storage onde ficam imagem, vídeo, áudio e
# documento. Privado é requisito, não preferência — são fotos e áudios de
# conversas de eleitores; o acesso é por URL assinada de curta duração.
#
# AUSENTE em dev local é aceitável: a conversa continua funcionando e a
# mídia é gravada como 'ignorada' com o motivo na tela, nunca como texto
# vazio.
#
# (Era GCS_BUCKET_MIDIA até 01/09/2026. Com o Supabase some a exigência de
# iam.serviceAccountTokenCreator sobre a própria service account, que era o
# que quebrava a primeira mídia aberta em produção.)
SUPABASE_BUCKET_MIDIA=
MIDIA_TAMANHO_MAX_MB=16
# Validade da URL assinada entregue ao navegador. Curta de propósito: ela
# dá acesso ao arquivo a quem a tiver, então não deve sobreviver a um
# print ou a um copiar-e-colar.
MIDIA_URL_TTL_SEGUNDOS=600
# Downloads simultâneos. Baixo de propósito: este processo é o mesmo que
# segura os sockets do WhatsApp (1 instância), e trabalho de fundo não
# pode competir com a entrega de mensagem — nem com a fila de disparo.
MIDIA_CONCORRENCIA=2

# --------------------------------------------------------------------
# Transcrição de áudio — DESLIGADA nesta infraestrutura
# --------------------------------------------------------------------
# Dependia do Google Speech-to-Text lendo `gs://` direto do bucket, e não há
# mais bucket no GCS. `transcricaoAtiva()` exige GCP_PROJECT_ID **e**
# GCS_BUCKET_MIDIA; nenhum dos dois existe aqui, então ela devolve `false`
# sozinha — nenhuma configuração necessária.
#
# O que se perde: o áudio deixa de virar texto para o resumo e a triagem. O
# player continua funcionando normalmente.
#
# As três abaixo ficam documentadas para o dia em que houver um provedor de
# transcrição por API. Hoje não fazem nada.
TRANSCRICAO_ATIVA=false
TRANSCRICAO_LOCAL=
TRANSCRICAO_MAX_MINUTOS=15

# --------------------------------------------------------------------
# Posse do gateway (específico do Render)
# --------------------------------------------------------------------
# O Render sobe a instância nova ANTES de encerrar a velha. Só a dona da
# posse reconecta canais, roda o vigia e dispara — sem isso, duas sessões
# Baileys na mesma identidade se derrubam mutuamente.
# Ver src/jobs/lease.ts e a migration 20260901120000_gateway_lease.sql.
#
# Os defaults servem. Só mexa se o desligamento da instância velha demorar
# mais que o prazo, o que apareceria no log como troca de posse em looping.
GATEWAY_LEASE_TTL_SEG=45
GATEWAY_LEASE_RENOVACAO_MS=15000

# --------------------------------------------------------------------
# HTTP
# --------------------------------------------------------------------
# O Render injeta PORT em runtime. O 8081 abaixo só vale fora dele.
PORT=8081
# Origem(ns) do front permitida(s) para CORS, separadas por vírgula. Sem
# isto, cai no default de dev (http://localhost:8080). Produção deve
# apontar pro domínio real do front, não deixar no default.
CORS_ORIGIN=http://localhost:8080
# URL do front, usada para montar o redirectTo do convite/definir-senha.
# Essa mesma URL + "/definir-senha" precisa estar cadastrada em
# Authentication -> URL Configuration -> Redirect URLs no painel do
# Supabase, senão o link do convite é rejeitado.
APP_BASE_URL=http://localhost:8080
