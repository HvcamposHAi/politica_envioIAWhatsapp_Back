# Backend da Central de Mensagens — campanha Indiara.
# service_role e DATABASE_URL vivem SÓ aqui, nunca no front. Em produção
# (GCP) isto vem do Secret Manager, não de um .env em texto plano.
#
# ⚠️  Fase 0: o projeto Supabase e o projeto GCP são NOVOS e dedicados a
#     esta campanha. Não reaproveitar credencial de nenhum outro projeto —
#     este backend roda com service_role, que bypassa RLS e lê tudo.

# --------------------------------------------------------------------
# Supabase — projeto dedicado da campanha
# --------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# service_role: bypassa RLS. Nunca expor ao front. Nunca logar.
SUPABASE_SERVICE_ROLE_KEY=
# Conexão direta (worker Baileys, auth state em hub.canal_sessoes).
DATABASE_URL=

# --------------------------------------------------------------------
# IA
# --------------------------------------------------------------------
# Personalização do disparo, resposta 1:1, triagem e painel analítico.
ANTHROPIC_API_KEY=

# --------------------------------------------------------------------
# Disparo (Fase 3) — ritmo da linha
# --------------------------------------------------------------------
# Estes são os TETOS do processo, o piso de segurança que nenhum disparo
# configurado na UI pode ultrapassar. O que o admin configura por campanha
# fica em hub.disparos; o que está aqui é o limite duro do ambiente.
#
# Janela de envio (hora local de São Paulo). Fora dela o worker dorme.
# Sem envio de madrugada: é o comportamento que mais gera denúncia.
DISPARO_JANELA_INICIO=09:00
DISPARO_JANELA_FIM=20:00
# Intervalo entre mensagens, em segundos. O worker sorteia dentro da
# faixa a cada envio.
DISPARO_INTERVALO_MIN_SEG=25
DISPARO_INTERVALO_MAX_SEG=90
# Rampa de aquecimento por dia de vida do canal, em mensagens/dia.
# Linha nova não começa disparando (ver Fase 3 do plano).
DISPARO_RAMPA=40,80,150,250,400
# Limiares de pausa automática, em percentual da janela recente.
DISPARO_LIMIAR_FALHA_PCT=15
DISPARO_LIMIAR_OPTOUT_PCT=5
# Interruptor geral. `false` faz o worker recusar qualquer envio em massa
# sem precisar de redeploy — a válvula de escape se algo der errado.
DISPARO_ATIVO=true

# --------------------------------------------------------------------
# Twilio — opcional, só para conversa 1:1
# --------------------------------------------------------------------
# O disparo em massa desta plataforma é por Baileys (decisão de 31/08).
# O adapter Twilio continua no código e serve a canais com
# transporte='twilio' para atendimento 1:1. Deixar em branco desliga.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# URL pública e ESTÁVEL deste serviço (a mesma cadastrada no Console da
# Twilio como webhook), usada para reconstruir a URL assinada na
# validação de X-Twilio-Signature. NÃO derivar de req.protocol/host em
# runtime — Cloud Run termina TLS antes do container.
TWILIO_WEBHOOK_BASE_URL=
# Id do projeto GCP. Presente = credenciais Twilio vêm do Secret Manager
# (ADC — nada de chave de conta de serviço em arquivo). Ausente = dev
# local, lê as duas variáveis acima direto daqui.
GCP_PROJECT_ID=

# --------------------------------------------------------------------
# Mídia do WhatsApp
# --------------------------------------------------------------------
# Bucket GCS privado onde ficam imagem, vídeo, áudio e documento. AUSENTE
# em dev local é aceitável: a conversa continua funcionando e a mídia é
# gravada como 'ignorada' com o motivo na tela — nunca como texto vazio.
# A service account precisa de storage.objectAdmin NESTE bucket e de
# iam.serviceAccountTokenCreator SOBRE SI MESMA (sem o segundo, assinar a
# URL falha em runtime com "Cannot sign data without client_email").
GCS_BUCKET_MIDIA=
MIDIA_TAMANHO_MAX_MB=16
# Validade da URL assinada entregue ao navegador. Curta de propósito: ela
# dá acesso ao arquivo a quem a tiver, então não deve sobreviver a um
# print ou a um copiar-e-colar.
MIDIA_URL_TTL_SEGUNDOS=600
# Downloads simultâneos. Baixo de propósito: este processo é o mesmo que
# segura os sockets do WhatsApp (1 instância), e trabalho de fundo não
# pode competir com a entrega de mensagem — nem com a fila de disparo.
MIDIA_CONCORRENCIA=2

# --------------------------------------------------------------------
# Transcrição de áudio — Google Cloud Speech-to-Text v2 (chirp_2, pt-BR)
# --------------------------------------------------------------------
# Usa ADC, sem chave: exige speech.googleapis.com habilitada e o papel
# roles/speech.client na service account. Desligar aqui é a válvula de
# escape se o custo por minuto surpreender — sem redeploy, e o player
# continua funcionando (só a transcrição some).
TRANSCRICAO_ATIVA=true
# chirp_2 não existe em southamerica-east1; us-central1 é a região com o
# modelo, e o áudio já está num bucket que a SA lê.
TRANSCRICAO_LOCAL=us-central1
# Acima disto o áudio fica 'ignorada' com o motivo na tela — não é erro.
TRANSCRICAO_MAX_MINUTOS=15

# --------------------------------------------------------------------
# HTTP
# --------------------------------------------------------------------
PORT=8081
# Origem(ns) do front permitida(s) para CORS, separadas por vírgula. Sem
# isto, cai no default de dev (http://localhost:8080). Produção deve
# apontar pro domínio real do front, não deixar no default.
CORS_ORIGIN=http://localhost:8080
# URL do front, usada para montar o redirectTo do convite/definir-senha.
# Essa mesma URL + "/definir-senha" precisa estar cadastrada em
# Authentication -> URL Configuration -> Redirect URLs no painel do
# Supabase, senão o link do convite é rejeitado.
APP_BASE_URL=http://localhost:8080
